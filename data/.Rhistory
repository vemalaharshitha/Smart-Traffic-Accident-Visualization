# Install igraph if needed
install.packages("igraph")
library(igraph)
# Create student names
students <- c("Alice", "Bob", "Charlie", "David", "Eva", "Frank")
# Create collaboration data
collaborations <- data.frame(
from = c("Alice", "Alice", "Alice","Bob", "Bob","Charlie", "David", "Eva"),
to = c("Bob", "Charlie", "David", "Charlie", "Eva","David", "Eva", "Frank"),
strength = c(5, 3, 2, 4, 1, 6, 2, 3)
)
# Create undirected graph
g <- graph_from_data_frame(
collaborations,
directed = FALSE,
vertices = students
)
# Calculate number of collaborations for each student
degree_value <- degree(g)
# Node size based on degree
V(g)$size <- 10 + degree_value * 5
# Create darker colors for stronger collaborations
strength <- E(g)$strength
edge_colors <- gray.colors(
10,
start = 0.9,
end = 0.2
)
E(g)$color <- edge_colors[
pmax(1, pmin(10, strength))
]
# Edge width also shows collaboration strength
E(g)$width <- 1 + strength / 2
# Force-directed layout
set.seed(123)
layout <- layout_with_fr(g)
# Draw node-link diagram
plot(
g,
layout = layout,
vertex.label = V(g)$name,
vertex.size = V(g)$size,
vertex.color = "skyblue",
vertex.label.color = "black",
edge.color = E(g)$color,
edge.width = E(g)$width,
main = "Student Collaboration Network"
)
library(igraph)
# Create nodes
nodes <- data.frame(
name = c(
"Supplier1",
"Supplier2",
"Supplier3",
"Manufacturer1",
"Manufacturer2",
"Distributor1",
"Distributor2"
),
category = c(
"Supplier",
"Supplier",
"Supplier",
"Manufacturer",
"Manufacturer",
"Distributor",
"Distributor"
)
)
# Install igraph if needed
# install.packages("igraph")
library(igraph)
# Create nodes
nodes <- data.frame(
name = c(
"Supplier1",
"Supplier2",
"Supplier3",
"Manufacturer1",
"Manufacturer2",
"Distributor1",
"Distributor2"
),
category = c(
"Supplier",
"Supplier",
"Supplier",
"Manufacturer",
"Manufacturer",
"Distributor",
"Distributor"
)
)
# Create supply relationships
edges <- data.frame(
from = c(
"Supplier1",
"Supplier2",
"Supplier3",
"Supplier1",
"Supplier2",
"Manufacturer1",
"Manufacturer2"
),
to = c(
"Manufacturer1",
"Manufacturer1",
"Manufacturer2",
"Manufacturer2",
"Manufacturer2",
"Distributor1",
"Distributor2"
),
volume = c(100, 150, 80, 60, 120, 200, 170)
)
# Create graph
g <- graph_from_data_frame(
edges,
directed = TRUE,
vertices = nodes
)
# Assign node colors by category
V(g)$color <- ifelse(
V(g)$category == "Supplier",
"green",
ifelse(
V(g)$category == "Manufacturer",
"blue",
"orange"
)
)
# Edge width based on transaction volume
E(g)$width <- 1 + E(g)$volume / 50
# Force-directed layout
set.seed(123)
layout <- layout_with_fr(g)
# Create node-link diagram
plot(
g,
layout = layout,
vertex.label = V(g)$name,
vertex.color = V(g)$color,
vertex.size = 25,
vertex.label.color = "black",
edge.width = E(g)$width,
edge.arrow.size = 0.4,
main = "Business Supply Chain Network"
)
install.packages("igraph")
library(igraph)
# Create an 8 x 8 adjacency matrix
m <- matrix(0, nrow = 8, ncol = 8)
# Add friendships
m[1,2] <- m[2,1] <- 1
m[1,3] <- m[3,1] <- 1
m[1,4] <- m[4,1] <- 1
m[2,3] <- m[3,2] <- 1
m[2,5] <- m[5,2] <- 1
m[3,6] <- m[6,3] <- 1
m[4,7] <- m[7,4] <- 1
m[5,8] <- m[8,5] <- 1
m[6,8] <- m[8,6] <- 1
# Display adjacency matrix
print(m)
# Visualize matrix
image(m)
# Create undirected graph
g <- graph_from_adjacency_matrix(
m,
mode = "undirected"
)
# Display graph
plot(
g,
vertex.color = "skyblue",
vertex.size = 30,
vertex.label.color = "black"
)
# Find degree of every student
degree(g)
# Find connected components
components(g)
library(igraph)
# Create ring topology with 10 computers
g <- make_ring(10)
# Add additional cross-links
g <- add_edges(
g,
c(
1,5,
2,7,
3,8,
4,9
)
)
# Convert graph to adjacency matrix
m <- as.matrix(
as_adjacency_matrix(g)
)
# Display adjacency matrix
print(m)
# Visualize adjacency matrix
image(
m,
main = "Computer Lab Adjacency Matrix",
xlab = "Computers",
ylab = "Computers"
)
# Display network
plot(
g,
vertex.size = 25,
vertex.color = "lightgreen",
vertex.label = 1:10
)
# Calculate degree
degree(g)
