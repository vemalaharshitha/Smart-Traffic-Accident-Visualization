library(ggplot2)
# 1. Generate 10 x 10 x 10 grid
x <- seq(-pi, pi, length.out = 10)
y <- seq(-pi, pi, length.out = 10)
z <- seq(-pi, pi, length.out = 10)
grid <- expand.grid(x = x, y = y, z = z)
# 2. Define vector components
grid$vx <- sin(grid$x)
grid$vy <- cos(grid$y)
grid$vz <- sin(grid$z)
# -------------------------------
# 3. Heatmap for VX
# -------------------------------
# Fix z at middle value
slice_vx <- grid[grid$z == z[5], ]
ggplot(slice_vx, aes(x = x, y = y, fill = vx)) +
geom_tile() +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red"
) +
labs(
title = "Heatmap of vx = sin(x)",
x = "X",
y = "Y",
fill = "vx"
) +
theme_minimal()
# -------------------------------
# 4. Heatmap for VY
# -------------------------------
# Fix z at middle value
slice_vy <- grid[grid$z == z[5], ]
ggplot(slice_vy, aes(x = x, y = y, fill = vy)) +
geom_tile() +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red"
) +
labs(
title = "Heatmap of vy = cos(y)",
x = "X",
y = "Y",
fill = "vy"
) +
theme_minimal()
# -------------------------------
# 5. Heatmap for VZ
# -------------------------------
# Fix y at middle value
slice_vz <- grid[grid$y == y[5], ]
ggplot(slice_vz, aes(x = x, y = z, fill = vz)) +
geom_tile() +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red"
) +
labs(
title = "Heatmap of vz = sin(z)",
x = "X",
y = "Z",
fill = "vz"
) +
theme_minimal()
Fix y at middle value
